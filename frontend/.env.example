# URL base da API REST do backend
VITE_API_URL=http://localhost:8080

# Usa a camada local de dados (src/services/mock/) enquanto o backend não existe.
# Defina como "false" para consumir a API real
VITE_USE_MOCKS=true

# Observação: a configuração do Assistente de IA (provedor, chave, modelo) é feita
# pela própria interface, em Configurações, e fica salva no localStorage do navegador.
# Não coloque a chave de API aqui no .env — nunca comite chaves no código.
